{
  "name": "xiangqi-gui",
  "version": "0.4.3",
  "description": "象棋 AI——基于楚河引擎（UCI）的中国象棋对弈与分析工具：人机/机机/人人对弈、实时分析、AI 点评、LLM 复盘解说、残局闯关、名局欣赏、多引擎对决、自定义主题/快捷键/开局库",
  "author": "象棋 AI",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "app": "electron .",
    "build": "tsc --noEmit && vite build",
    "build:rules": "esbuild src/rules/exports.ts --bundle --platform=node --format=cjs --outfile=../scripts/rules.cjs",
    "dist": "vite build && electron-builder --win nsis",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\""
  },
  "build": {
    "appId": "com.xiangqi.ai",
    "productName": "象棋AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../engine",
        "to": "engine",
        "filter": [
          "**/*",
          "!**/legal/Pikafish-*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "象棋AI"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
